# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Public URL of the frontend (no trailing slash). Used for CORS and OAuth redirects.
FRONTEND_URL=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorpulse?schema=public

# ---------- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
SESSION_SECRET=
ENCRYPTION_SECRET=

# ---------- Google OAuth (Google Cloud Console) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI exactly, e.g. http://localhost:4000/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback
# Future Android app deep link used when /api/auth/google?platform=android
ANDROID_REDIRECT_URI=creatorpulse://auth

# ---------- Gemini (configured by the administrator only) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=100

# ---------- Monitoring ----------
# Set true to run the hourly monitor inside the web service (when you have no separate Render Worker)
ENABLE_INLINE_WORKER=false
MONITOR_WINDOW_DAYS=30
MONITOR_MIN_VIEWS=30
